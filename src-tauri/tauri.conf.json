{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subbit",
  "version": "0.0.1",
  "identifier": "com.sywyyhykkk.subbit",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [], "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "category": "Finance", "shortDescription": "Your digital life, at a glance.", "macOS": {"minimumSystemVersion": "12.0"}, "windows": {"webviewInstallMode":{"type":"downloadBootstrapper"}} }
}
